<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ShopEase - Online Shopping</title>

<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f7f7f7;color:#333}
header{background:white;padding:15px 5%;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.logo{font-size:28px;font-weight:bold;color:#a80068}
.search{padding:12px;width:40%;min-width:150px;border:1px solid #ddd;border-radius:5px}
nav{background:white;border-top:1px solid #eee;padding:14px;text-align:center}
nav a{margin:0 12px;color:#333;text-decoration:none}
.hero{background:#f9ddeb;text-align:center;padding:35px 15px}
.hero h1{color:#a80068;font-size:32px}
.hero p{font-size:17px}
h2{text-align:center;margin:25px 0}
.categories{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;padding:10px}
.categories button{background:white;border:1px solid #ddd;padding:12px 18px;border-radius:20px;cursor:pointer}
.products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;padding:15px;max-width:1200px;margin:auto}
.card{background:white;border-radius:7px;padding:10px;overflow:hidden}
.card img{width:100%;height:190px;object-fit:cover}
.card h3{font-size:15px;margin:10px 0}
.price{font-weight:bold;color:#333}
.old{color:#888;text-decoration:line-through;font-size:12px}
.card button{background:#a80068;color:white;border:0;padding:10px;width:100%;border-radius:4px;cursor:pointer}
.cart{text-align:center;background:white;padding:20px;margin-top:20px}
footer{background:#333;color:white;text-align:center;padding:25px;margin-top:20px}
@media(max-width:700px){.products{grid-template-columns:repeat(2,minmax(0,1fr))}.card img{height:170px}.search{width:100%;order:3}header{justify-content:space-between}nav a{margin:0 6px;font-size:13px}}
</style>
</head>

<body>

<header>
  <div class="logo">ShopEase</div>
  <input class="search" id="search" placeholder="Search for products..." oninput="renderProducts()">
  <div>🛒 Cart: <span id="count">0</span></div>
</header>

<nav>
  <a href="#home">Home</a>
  <a href="#categories">Categories</a>
  <a href="#products">Products</a>
  <a href="#cart">My Cart</a>
</nav>

<section class="hero" id="home">
  <h1>Big Style, Small Prices!</h1>
  <p>Discover fashion, accessories and everyday essentials.</p>
  <a href="#products"><button>Shop Now</button></a>
</section>

<h2 id="categories">Shop by Category</h2>
<div class="categories">
  <button onclick="chooseCategory('All')">All</button>
  <button onclick="chooseCategory('Women')">Women</button>
  <button onclick="chooseCategory('Men')">Men</button>
  <button onclick="chooseCategory('Accessories')">Accessories</button>
</div>

<h2 id="products">Trending Products</h2>
<div class="products" id="productList"></div>

<section class="cart" id="cart">
  <h2>Your Shopping Cart</h2>
  <div id="cartItems">Your cart is empty.</div>
  <h3>Total: ₹<span id="total">0</span></h3>
  <button onclick="checkout()">Place Order</button>
  <p id="message"></p>
</section>

<footer>
  <h3>ShopEase</h3>
  <p>Your everyday shopping destination.</p>
  <p>© 2026 ShopEase Demo</p>
</footer>

<script>
const products = [
  {id:1,name:"Women's Kurti",category:"Women",price:499,old:899,image:"https://images.unsplash.com/photo-1583391733956-6c78276477e9?auto=format&fit=crop&w=500&q=80"},
  {id:2,name:"Stylish Dress",category:"Women",price:699,old:1199,image:"https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=500&q=80"},
  {id:3,name:"Casual Shirt",category:"Men",price:599,old:999,image:"https://images.unsplash.com/photo-1603252109303-2751441dd157?auto=format&fit=crop&w=500&q=80"},
  {id:4,name:"Fashion Bag",category:"Accessories",price:399,old:799,image:"https://images.unsplash.com/photo-1548036328-c9fa89d128fa?auto=format&fit=crop&w=500&q=80"},
  {id:5,name:"Modern Outfit",category:"Women",price:799,old:1499,image:"https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=500&q=80"},
  {id:6,name:"Men's Fashion",category:"Men",price:699,old:1099,image:"https://images.unsplash.com/photo-1618354691373-d851c5c3a990?auto=format&fit=crop&w=500&q=80"},
  {id:7,name:"Classic Accessories",category:"Accessories",price:249,old:499,image:"https://images.unsplash.com/photo-1611652022419-a9419f74343d?auto=format&fit=crop&w=500&q=80"},
  {id:8,name:"Party Wear",category:"Women",price:999,old:1699,image:"https://images.unsplash.com/photo-1595777457583-95e059d581b8?auto=format&fit=crop&w=500&q=80"}
];

let cart = [];
let category = "All";

function renderProducts(){
  const query = document.getElementById("search").value.toLowerCase();
  const filtered = products.filter(p =>
    (category === "All" || p.category === category) &&
    p.name.toLowerCase().includes(query)
  );

  document.getElementById("productList").innerHTML =
    filtered.map(p => `
      <div class="card">
        <img src="${p.image}" alt="${p.name}">
        <h3>${p.name}</h3>
        <p class="price">₹${p.price} <span class="old">₹${p.old}</span></p>
        <button onclick="addToCart(${p.id})">Add to Cart</button>
      </div>
    `).join("") || "<p>No products found.</p>";
}

function chooseCategory(value){
  category = value;
  renderProducts();
  document.getElementById("products").scrollIntoView();
}

function addToCart(id){
  cart.push(products.find(p => p.id === id));
  updateCart();
}

function updateCart(){
  document.getElementById("count").textContent = cart.length;
  document.getElementById("total").textContent =
    cart.reduce((sum,p) => sum + p.price, 0);

  document.getElementById("cartItems").innerHTML =
    cart.length
      ? cart.map((p,i) =>
          `<p>${p.name} — ₹${p.price}
          <button onclick="removeItem(${i})">Remove</button></p>`
        ).join("")
      : "Your cart is empty.";

  document.getElementById("message").textContent = "";
}

function removeItem(index){
  cart.splice(index,1);
  updateCart();
}

function checkout(){
  document.getElementById("message").textContent =
    cart.length
    ? "Demo only: online ordering and payment are not connected yet."
    : "Please add a product to your cart first.";
}

renderProducts();
</script>

</body>
</html>
